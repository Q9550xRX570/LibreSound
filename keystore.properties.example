# Copy to keystore.properties (git-ignored) to sign release APKs with your
# Verified Developer Signature, or provide LIBREOPUS_KEYSTORE_* env variables.
# If neither is present, :app:assembleLiteRelease produces an unsigned APK
# suitable for F-Droid reproducible build verification.
storeFile=/absolute/path/to/your-release.keystore
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password
